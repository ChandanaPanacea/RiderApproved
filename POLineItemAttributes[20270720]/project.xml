    <Graph ClassName="POOrderEntry" Source="#CDATA" IsNew="True" FileType="ExistingGraph">
        <CDATA name="Source"><![CDATA[using System.Collections.Generic;
using System.Linq;
using PX.Data;
using PX.Data.BQL;
using PX.Data.BQL.Fluent;
using PX.Objects.CS;
using PX.Objects.IN;
using PX.Objects.PO;

namespace POVariantAttributesDisplay
{
    public class POOrderEntryExtension : PXGraphExtension<POOrderEntry>
    {
        public static bool IsActive() => true;

        protected virtual void _(Events.FieldUpdated<POLine, POLine.inventoryID> e, PXFieldUpdated baseMethod)
        {
            baseMethod?.Invoke(e.Cache, e.Args);

            POLine row = e.Row;
            if (row?.InventoryID == null)
                return;

            InventoryItem item = InventoryItem.PK.Find(Base, row.InventoryID);

            var groups = SelectFrom<CSAttributeGroup>
                .Where<CSAttributeGroup.attributeID.IsIn<@P.AsString, @P.AsString>
                    .And<CSAttributeGroup.entityClassID.IsEqual<@P.AsString>>>
                .View.Select(Base, "COLORS", "SIZE", item.ItemClassID)
                .RowCast<CSAttributeGroup>()
                .ToArray();

            var answers = SelectFrom<CSAnswers>
                .Where<CSAnswers.refNoteID.IsEqual<@P.AsGuid>
                    .And<CSAnswers.attributeID.IsIn<@P.AsString, @P.AsString>>>
                .View.Select(Base, item.NoteID, "COLORS", "SIZE")
                .RowCast<CSAnswers>()
                .ToDictionary(a => a.AttributeID, a => a.Value);

            string color = groups.Any(g => g.AttributeID == "COLORS"
                            && g.AttributeCategory == CSAttributeGroup.attributeCategory.Variant)
                ? GetAttributeDescription("COLORS", answers)
                : null;

            string size = groups.Any(g => g.AttributeID == "SIZE"
                            && g.AttributeCategory == CSAttributeGroup.attributeCategory.Variant)
                ? GetAttributeDescription("SIZE", answers)
                : null;

            e.Cache.SetValueExt<POLineExtn.usrPOColor>(row, color);
            e.Cache.SetValueExt<POLineExtn.usrPOSize>(row, size);
        }

        private string GetAttributeDescription(string attributeID, Dictionary<string, string> answers)
        {
            if (!answers.TryGetValue(attributeID, out string valueID) || string.IsNullOrEmpty(valueID))
                return null;

            CSAttributeDetail detail = SelectFrom<CSAttributeDetail>
                .Where<CSAttributeDetail.attributeID.IsEqual<@P.AsString>
                    .And<CSAttributeDetail.valueID.IsEqual<@P.AsString>>>
                .View.Select(Base, attributeID, valueID);

            return detail?.Description;
        }
    }
}]]></CDATA>
